# Public browser-safe Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, only for linking/pushing migrations with Supabase CLI.
SUPABASE_ACCESS_TOKEN=

# Assistant, disabled until the provider, gateway and server limits are configured.
VETIA_AI_ENABLED=false
# Modelo Groq con Structured Outputs estricto, por ejemplo openai/gpt-oss-20b.
VETIA_AI_MODEL=
GROQ_API_KEY=
VETIA_AI_GATEWAY_KEY=
